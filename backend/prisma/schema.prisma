generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  GENERAL_MANAGER
  PROJECT_MANAGER
  SITE_MANAGER
  PURCHASER
  SYS_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
}

enum TicketType {
  MATERIAL_REQUEST
  WORK_ITEM
}

enum TicketStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BIRValidationStatus {
  FORMAL
  INFORMAL
}

enum VendorApprovalStatus {
  APPROVED
  FLAGGED
}

enum FlagType {
  BIR_DUPLICATE
  VENDOR_VALIDATION
  TICKET_MISMATCH
}

enum BlockchainEventType {
  EXPENSE_APPROVED
  REPORT_GENERATED
  SYNC_COMPLETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id                    // Supabase Auth UUID
  email        String     @unique
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  lockoutUntil DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  projectsCreated   Project[]        @relation("ProjectCreatedBy")
  projectMembers    ProjectMember[]
  milestonesCreated Milestone[]      @relation("MilestoneCreatedBy")
  tasksAssigned     Task[]           @relation("TaskAssignedTo")
  tasksUpdatedBy    Task[]           @relation("TaskUpdatedBy")
  taskUpdates       TaskUpdate[]
  ticketsSubmitted  Ticket[]         @relation("TicketSubmittedBy")
  ticketsAssigned   Ticket[]         @relation("TicketAssignedTo")
  ticketsResolved   Ticket[]         @relation("TicketResolvedBy")
  expensesSubmitted Expense[]        @relation("ExpenseSubmittedBy")
  expensesApproved  Expense[]        @relation("ExpenseApprovedBy")
  vendorsAdded      VendorMasterList[]
  fraudFlagsReviewed FraudFlag[]     @relation("FraudFlagReviewedBy")
  blockchainLogs    BlockchainLog[]
}

model Project {
  id            String        @id @default(cuid())
  createdBy     String
  creator       User          @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  name          String
  description   String?
  clientName    String
  status        ProjectStatus @default(ACTIVE)
  budget        Decimal       @db.Decimal(15, 2)
  startDate     DateTime
  endDate       DateTime?
  completionPct Int           @default(0)
  createdAt     DateTime      @default(now())

  // Relations
  members            ProjectMember[]
  milestones         Milestone[]
  tickets            Ticket[]
  expenses           Expense[]
  receiptAllocations ReceiptAllocation[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String

  @@unique([projectId, userId])
}

model Milestone {
  id            String          @id @default(cuid())
  project       Project         @relation(fields: [projectId], references: [id])
  projectId     String
  createdBy     String
  creator       User            @relation("MilestoneCreatedBy", fields: [createdBy], references: [id])
  name          String
  targetDate    DateTime
  completionPct Int             @default(0)
  status        MilestoneStatus @default(ON_TRACK)
  completedAt   DateTime?
  createdAt     DateTime        @default(now())

  tasks Task[]
}

model Task {
  id                       String   @id @default(cuid())
  milestone                Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId              String
  projectId                String
  name                     String
  assignedTo               String
  assignee                 User     @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  updatedBy                String?
  updater                  User?    @relation("TaskUpdatedBy", fields: [updatedBy], references: [id])
  completionPct            Int      @default(0)
  photoEvidenceURL         String?
  dueDate                  DateTime
  status                   String   @default("PENDING")
  issueReport              String?
  scheduleVarianceAlertSent Boolean @default(false)
  lastUpdatedAt            DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  updates TaskUpdate[]
}

model TaskUpdate {
  id            String   @id @default(cuid())
  task          Task     @relation(fields: [taskId], references: [id])
  taskId        String
  submittedBy   String
  submitter     User     @relation(fields: [submittedBy], references: [id])
  completionPct Int
  issueText     String?
  createdAt     DateTime @default(now())
}

model Ticket {
  id            String       @id @default(cuid())
  project       Project      @relation(fields: [projectId], references: [id])
  projectId     String
  submittedBy   String
  submitter     User         @relation("TicketSubmittedBy", fields: [submittedBy], references: [id])
  resolvedBy    String?
  resolver      User?        @relation("TicketResolvedBy", fields: [resolvedBy], references: [id])
  assignedTo    String
  assignee      User         @relation("TicketAssignedTo", fields: [assignedTo], references: [id])
  recipientRole String                                              // "PURCHASER" or "SITE_MANAGER"
  type          TicketType
  subject       String
  description   String?
  status        TicketStatus @default(PENDING)
  photoURL      String?
  quantity      Int?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime     @updatedAt

  expenses Expense[]
}

model Expense {
  id                  String              @id @default(cuid())
  project             Project             @relation(fields: [projectId], references: [id])
  projectId           String
  submittedBy         String
  submitter           User                @relation("ExpenseSubmittedBy", fields: [submittedBy], references: [id])
  approvedBy          String?
  approver            User?               @relation("ExpenseApprovedBy", fields: [approvedBy], references: [id])
  ticket              Ticket?             @relation(fields: [ticketId], references: [id])
  ticketId            String?
  vendorName          String
  amount              Decimal             @db.Decimal(12, 2)
  receiptDate         DateTime
  category            String              // Labor, Materials, Equipment, Other
  birValidationStatus BIRValidationStatus
  receiptImageURL     String
  status              ExpenseStatus       @default(PENDING)
  submittedAt         DateTime            @default(now())
  birNumber           String?
  quantity            Decimal             @db.Decimal(10, 2)

  // Relations
  fraudFlags         FraudFlag[]
  blockchainLogs     BlockchainLog[]
  receiptAllocations ReceiptAllocation[]
}

model ReceiptAllocation {
  id              String   @id @default(cuid())
  expense         Expense  @relation(fields: [expenseId], references: [id])
  expenseId       String
  project         Project  @relation(fields: [projectId], references: [id])
  projectId       String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  commonReceiptId String
  createdAt       DateTime @default(now())
}

model VendorMasterList {
  id               String               @id @default(cuid())
  addedBy          String
  adder            User                 @relation(fields: [addedBy], references: [id])
  vendorName       String               @unique
  location         String?
  historicalAverage Decimal?            @db.Decimal(12, 2)
  approvalStatus   VendorApprovalStatus @default(APPROVED)
  createdAt        DateTime             @default(now())
}

model FraudFlag {
  id             String    @id @default(cuid())
  expense        Expense   @relation(fields: [expenseId], references: [id])
  expenseId      String
  reviewedBy     String?
  reviewer       User?     @relation("FraudFlagReviewedBy", fields: [reviewedBy], references: [id])
  flaggedBy      String                                              // "SYSTEM" or user id
  flagType       FlagType
  detectionLayer String                                              // BIR_DUPLICATE | VENDOR_VALIDATION | TICKET_MISMATCH
  reason         String
  resolution     String?
  flaggedAt      DateTime  @default(now())
  resolvedAt     DateTime?
}

model BlockchainLog {
  id                 String              @id @default(cuid())
  expense            Expense             @relation(fields: [expenseId], references: [id])
  expenseId          String
  actor              User                @relation(fields: [actorId], references: [id])
  actorId            String
  txHash             String              @unique
  blockNumber        Int
  eventType          BlockchainEventType
  validatorNodeCount Int
  consensusType      String              @default("Clique")
  timestamp          DateTime            @default(now())
}