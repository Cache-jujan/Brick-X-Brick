generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

enum Role { 
  ADMIN 
  PURCHASER 
  SITE_MANAGER 
  ACCOUNTANT 
}

enum RequestStatus {
  PENDING
  APPROVED
  PURCHASED
  DELIVERED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVE
  REJECTED
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  role             Role
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  projectMembers   ProjectMember[]
  materialRequests MaterialRequest[]
  workItems        WorkItem[]
  expenses         Expense[]
  auditLogs        AuditLog[]
}
 
model Project {
  id                      String              @id @default(cuid())
  name                    String
  description             String?
  location                String?
  budget                  Decimal             @db.Decimal(12, 2)
  startDate               DateTime
  endDate                 DateTime?
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  members                 ProjectMember[]
  materialRequests        MaterialRequest[]
  workItems               WorkItem[]
  expenses                Expense[]
}
 
model ProjectMember {
  id                      String              @id @default(cuid())
  project                 Project             @relation(fields: [projectId], references: [id])
  projectId               String
  user                    User                @relation(fields: [userId], references: [id])
  userId                  String
  @@unique([projectId, userId])
}
 
model MaterialRequest {
  id                      String              @id @default(cuid())
  project                 Project             @relation(fields: [projectId], references: [id])
  projectId               String
  requestedBy             User                @relation(fields: [userId], references: [id])
  userId                  String
  items                   Json
  status                  RequestStatus       @default(PENDING)
  urgency                 String              @default("NORMAL")
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}
 
model WorkItem {
  id                      String              @id @default(cuid())
  project                 Project             @relation(fields: [projectId], references: [id])
  projectId               String
  loggedBy                User                @relation(fields: [userId], references: [id])
  userId                  String
  title                   String
  description             String?
  progress                Int                 @default(0)
  laborCost               Decimal?            @db.Decimal(10, 2)
  workDate                DateTime
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}
 
model Expense {
  id                      String              @id @default(cuid())
  project                 Project             @relation(fields: [projectId], references: [id])
  projectId               String
  submittedBy             User                @relation(fields: [userId], references: [id])
  userId                  String
  vendor                  String
  amount                  Decimal             @db.Decimal(10, 2)
  category                String
  orNumber                String?
  receiptPath             String?  // local file path for now instead of Cloudinary URL
  description             String?
  status                  ExpenseStatus       @default(PENDING)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}
 
model AuditLog {
  id                      String              @id @default(cuid())
  user                    User?               @relation(fields: [userId], references: [id])
  userId                  String?
  action                  String
  entity                  String
  entityId                String?
  oldValue                Json?
  newValue                Json?
  createdAt               DateTime            @default(now())
}
