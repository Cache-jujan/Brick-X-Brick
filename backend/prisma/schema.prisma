generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GENERAL_MANAGER
  PROJECT_MANAGER
  SITE_MANAGER
  PURCHASER
  SYS_ADMIN
}

enum TicketType {
  MATERIAL_REQUEST
  WORK_ITEM
}

enum TicketStatus {
  UNASSIGNED
  PENDING
  RESOLVED
  REJECTED
}

model User {
  id             String        @id
  email          String        @unique
  name           String
  role           Role
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  projectMembers ProjectMember[]
  assignedTickets Ticket[]     @relation("AssignedTickets")
  submittedUpdates TaskUpdate[]
  tasks          Task[]
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  clientName  String?
  budget      Decimal     @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean     @default(true)
  completionPct Int       @default(0)
  createdAt   DateTime    @default(now())
  members     ProjectMember[]
  milestones  Milestone[]
  tickets     Ticket[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  @@unique([projectId, userId])
}

model Milestone {
  id            String   @id @default(cuid())
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
  name          String
  targetDate    DateTime
  completionPct Int      @default(0)
  createdAt     DateTime @default(now())
  tasks         Task[]
}

model Task {
  id            String    @id @default(cuid())
  milestone     Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId   String
  projectId     String
  name          String
  assignedTo    String?
  assignee      User?     @relation(fields: [assignedTo], references: [id])
  completionPct Int       @default(0)
  targetDate    DateTime?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updates       TaskUpdate[]
}

model Ticket {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id])
  projectId   String
  type        TicketType
  description String
  quantity    Int?
  status      TicketStatus @default(UNASSIGNED)
  assignedTo  String?
  assignee    User?        @relation("AssignedTickets", fields: [assignedTo], references: [id])
  createdAt   DateTime     @default(now())
}

model TaskUpdate {
  id            String   @id @default(cuid())
  task          Task     @relation(fields: [taskId], references: [id])
  taskId        String
  submittedBy   String
  submitter     User     @relation(fields: [submittedBy], references: [id])
  completionPct Int
  issueText     String?
  createdAt     DateTime @default(now())
}